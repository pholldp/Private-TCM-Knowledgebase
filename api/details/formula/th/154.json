  "preparation_form": "ยาผง (ซ่าน / San)",
  "dynasty": "Wen Bing Tiao Bian (Systematic Differentiation of Warm Diseases) by Wu Jutong (吴鞠通)",
  "conditions": "[\"ไข้หวัดใหญ่\", \"โรคไข้หวัด\", \"ต่อมทอนซิลอักเสบ\", \"หลอดลมอักเสบ\", \"โรคหัด\", \"ก้อน\", \"โรคปอดบวม\", \"เยื่อบุตาอักเสบจากไวรัส\", \"ลมพิษ\"]",
