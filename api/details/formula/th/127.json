  "research": [
    {
      "id": 274,
      "formula_id": 127,
      "title": "Network meta-analysis: Comparative efficacy of 9 TCM formulas combined with standard quadruple therapy for H. pylori-associated gastritis (Systematic Review, 2022)",
      "description": "This systematic review and network meta-analysis evaluated nine traditional Chinese medicine formulas, including modified Lian Po Yin, combined with standard quadruple therapy for Helicobacter pylori-associated gastritis. Multiple RCTs of modified Lian Po Yin combined with quadruple therapy showed higher H. pylori eradication rates and therapeutic response rates compared to quadruple therapy alone, particularly in patients with Spleen-Stomach Damp-Heat syndrome.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/36660637/",
      "periodical": "Bao M et al., Annals of Translational Medicine, 2022, 10(24):1382"
    },
    {
      "id": 275,
      "formula_id": 127,
      "title": "Jiawei Lianpu Yin inhibits H. pylori colonization and alleviates gastric mucosal inflammation: Integrated transcriptomics, network pharmacology, and experimental validation (Preclinical, 2025)",
      "description": "This preclinical study investigated the mechanisms of a modified Lian Po Yin (Jiawei Lianpu Yin) in treating H. pylori-related gastritis using both in vitro and in vivo (rat) models. The study found that the formula inhibited H. pylori colonization in gastric mucosa, alleviated gastric inflammation and tissue damage, and acted through the IRE1/XBP1s signaling pathway affecting MUC5AC expression. This was the first study to demonstrate specific anti-colonization mechanisms for this formula.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/40239879/",
      "periodical": "Zhang X, Wang L, Huang L, Cao G, Huang C, Duan Y, Lyu W. Journal of Ethnopharmacology, 2025"
    }
  ],
