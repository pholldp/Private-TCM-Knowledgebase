  "research": [
    {
      "id": 83,
      "formula_id": 31,
      "title": "Qingwei San treats oral ulcer subjected to stomach heat syndrome in db/db mice by targeting TLR4/MyD88/NF-κB pathway (Preclinical study, 2022)",
      "description": "This preclinical study used diabetic (db/db) mice to model oral ulcers with stomach heat syndrome. QWS treatment promoted ulcer healing, reduced inflammatory infiltration in gastric and oral mucosa, and suppressed pro-inflammatory signaling through the TLR4/MyD88/NF-κB pathway. Network pharmacology analysis identified key bioactive components and multiple anti-inflammatory targets.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/34980192/",
      "periodical": "Liang J, et al. Chinese Medicine, 2022, 17(1):3."
    },
    {
      "id": 84,
      "formula_id": 31,
      "title": "Using computational pharmacology and experimental verification to decode mechanism of Qing-Wei-San in treating periodontitis (Computational and in vitro study, 2025)",
      "description": "This study used computational systems pharmacology to identify bioactive components of QWS relevant to periodontitis. Key compounds including ethyl ferulate, methyl protocatechuate, and quercetin were found to significantly reduce expression levels of inflammatory factors in an in vitro inflammatory model, supporting the formula's traditional use for gum inflammation.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/40634925/",
      "periodical": "BMC Complementary Medicine and Therapies, 2025."
    }
  ],
