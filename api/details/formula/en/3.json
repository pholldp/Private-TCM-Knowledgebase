  "research": [
    {
      "id": 9,
      "formula_id": 3,
      "title": "Meta-analysis of Si-Jun-Zi-Tang-based therapies for functional dyspepsia (2021)",
      "description": "This meta-analysis pooled data from 12 randomized controlled trials to evaluate Si Jun Zi Tang-based treatments for functional (non-ulcer) dyspepsia. The results showed a statistically significant improvement in response rate for SJZT-based therapies compared to conventional treatment (RR = 1.23, 95% CI 1.17-1.30), with lower relapse rates (OR = 0.23). No serious side effects were reported. However, the authors cautioned that all included studies had a high risk of bias, and larger, better-designed trials are needed.",
      "url": "https://doi.org/10.1186/s12906-020-03176-z",
      "periodical": "Wang Y, Liu B, Fu X, Tong T, Yu Z. BMC Complementary Medicine and Therapies, 2021, 21(1):11."
    },
    {
      "id": 10,
      "formula_id": 3,
      "title": "Systematic review of Sijunzi Decoction for chronic atrophic gastritis (2017)",
      "description": "This systematic review assessed 6 RCTs on modified Si Jun Zi Tang combined with conventional Western medicines for chronic atrophic gastritis (CAG). Pooled analysis from 4 trials showed a significant improvement in overall response rate compared to conventional medicines alone (OR = 4.86, 95% CI 2.80-8.44). No adverse effects were reported across the included studies. The authors noted limited trial numbers and methodological flaws, calling for higher-quality research.",
      "url": "https://doi.org/10.1155/2017/9012929",
      "periodical": "Qi Z, Chen L, Li Z, Shao Z, Qi Y, Gao K, Liu S, Sun Y, Li P, Liu J. Evidence-Based Complementary and Alternative Medicine, 2017, Article ID 9012929."
    },
    {
      "id": 11,
      "formula_id": 3,
      "title": "Network pharmacology and in vivo study on anti-aging mechanisms of Si Jun Zi Tang (2022)",
      "description": "Using network pharmacology and molecular docking combined with animal experiments in naturally aging mice, this study identified 235 potential targets linking Si Jun Zi Tang to aging. The PI3K-AKT and MAPK signaling pathways were identified as key mechanisms. In vivo experiments showed that SJZT reduced age-related phenotypes (hair loss, rickets) in mice with no obvious toxicity, supporting the traditional use of this formula for strengthening constitution.",
      "url": "https://doi.org/10.18632/aging.204055",
      "periodical": "Yuan Y, Zhang Y, Zheng R, Yuan H, Zhou R, Jia S, Liu J. Aging, 2022, 14(10):4420-4441."
    }
  ],
